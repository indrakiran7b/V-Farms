# Copy to .env.local for local development (never commit real values).
# Use a dedicated Supabase STAGING project for Preview/staging tests — not production.

# Public (browser + middleware)
# Canonical origin — required on Render/GoDaddy before build (no trailing slash).
# Staging example:  NEXT_PUBLIC_SITE_URL=https://your-service.onrender.com
# Production example: NEXT_PUBLIC_SITE_URL=https://vfarms.in
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias supported by the app:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (API routes, admin service role reads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy alias:
# SUPABASE_SECRET_KEY=

# Razorpay — use test keys for staging
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: transactional email (Resend) for booking confirmations
# RESEND_API_KEY=
# EMAIL_FROM="V-Farms <bookings@your-verified-domain.com>"

# Optional: enable documented staging HTTP checks when a harness is added
# STAGING_BASE_URL=
# STAGING_E2E=0
