# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PROPERTY_NAME=V-Farms

# Supabase (required for production; local JSON store is used when these are absent)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Staff authentication
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
ADMIN_BOOTSTRAP_EMAIL=owner@v-farms.example
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password

# Razorpay — test mode until the owner authorizes live credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM=V-Farms <bookings@example.com>
RESEND_FROM_EMAIL=V-Farms <bookings@example.com>
NOTIFY_OPS_EMAIL=owner@example.com

# Optional: POST /api/cron/notifications with Authorization: Bearer <secret>
CRON_SECRET=

# Optional
SENTRY_DSN=
RATE_LIMIT_REDIS_URL=
